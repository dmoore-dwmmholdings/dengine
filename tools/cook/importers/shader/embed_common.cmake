# embed_common.cmake: writes the C file that embeds the engine's shared Slang modules
# (shaders/common/*.slang) into the shader importer (DENG-289). Script mode:
#
#   cmake -DOUT=<file.c> -DDIR=<shaders/common> -DNAMES=<name;name;...> -P embed_common.cmake
#
# NAMES is the module order: the first is preloaded into every program (bindless). Each module is
# an unsigned byte array (the sources are UTF-8: a `char` initialiser above 127 overflows) with a
# trailing NUL that its size does not count. The output is rewritten only when it changes.
cmake_minimum_required(VERSION 3.25)

set(body "/* Generated by tools/cook/importers/shader/embed_common.cmake from shaders/common/.\n")
string(APPEND body " * Do not edit. */\n#include \"cook/importers/shader/slang_compile.h\"\n\n")
set(table "")
set(i 0)
foreach(name IN LISTS NAMES)
    file(READ "${DIR}/${name}.slang" hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR size "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # 16 bytes per line.
    string(REGEX REPLACE
        "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)"
        "\\1\n    " bytes "${bytes}")
    string(APPEND body "static const unsigned char k_module_${i}[${size} + 1] = {\n    ${bytes}0x00};\n\n")
    string(APPEND table "    {\"${name}\", (const char *)k_module_${i}, ${size}u},\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "const de__slang_module de__shader_common_modules[] = {\n${table}};\n")
string(APPEND body "const u32 de__shader_common_module_count = ${i}u;\n")
file(CONFIGURE OUTPUT "${OUT}" CONTENT "${body}" @ONLY)
