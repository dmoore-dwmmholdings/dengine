# embed_engine_shaders.cmake: writes engine_shaders_data.c, the table of the engine shaders of
# shaders/engine_shaders.cmake with their build-time cooked blobs embedded (DENG-421). Script mode:
#
#   cmake -DLIST=<engine_shaders_list.cmake> -DOUT=<file.c> -P embed_engine_shaders.cmake
#
# LIST (written by src/render/CMakeLists.txt at configure time) sets ESH_NAMES, ESH_SOURCES,
# ESH_PERMS (per shader: permutations split by '/', defines by ','), ESH_DIR (the .dshd blobs)
# and ESH_EMBED (ON: embed ${ESH_DIR}/<name>.dshd; OFF: the table only, no blobs). Each blob is a
# 16-byte aligned unsigned byte array. The output is rewritten only when it changes.
cmake_minimum_required(VERSION 3.25)
include("${LIST}")

set(body "/* Generated by src/render/shaders/embed_engine_shaders.cmake from\n")
string(APPEND body " * shaders/engine_shaders.cmake (DENG-421). Do not edit. */\n")
string(APPEND body "#include \"render/shaders/engine_shaders.h\"\n\n")
set(table "")
list(LENGTH ESH_NAMES count)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    list(GET ESH_NAMES ${i} name)
    list(GET ESH_SOURCES ${i} source)
    list(GET ESH_PERMS ${i} perms)
    if(perms STREQUAL "-")
        set(perms "")
    endif()
    if(ESH_EMBED)
        file(READ "${ESH_DIR}/${name}.dshd" hex HEX)
        string(LENGTH "${hex}" n)
        math(EXPR size "${n} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE
            "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)"
            "\\1\n    " bytes "${bytes}")
        string(APPEND body "static DE_ALIGN(16) const unsigned char k_blob_${i}[${size}] = {\n    ${bytes}};\n\n")
        string(APPEND table "    {\"${name}\", \"${source}\", \"${perms}\", k_blob_${i}, ${size}u},\n")
    else()
        string(APPEND table "    {\"${name}\", \"${source}\", \"${perms}\", NULL, 0u},\n")
    endif()
endforeach()
string(APPEND body "const de__engine_shader_info de__engine_shader_table[] = {\n${table}};\n")
string(APPEND body "const u32 de__engine_shader_count = ${count}u;\n")
file(CONFIGURE OUTPUT "${OUT}" CONTENT "${body}" @ONLY)
