/*
 * main() of the statically linked game "@DE_GAME_NAME@" (SPEC §10.1, Shipping).
 * Generated by de_add_game() (cmake/DeAddGame.cmake) from src/host/exe/static_main.c.in.
 * Do not edit: change the template.
 *
 * The game's code is the same as in the library build; here it is linked into this executable,
 * and its de_game_get_api() table goes to de_host_run as de_host_desc.static_api. No library is
 * loaded (de_host_desc.game_library stays NULL), and game:/ is this executable's directory.
 */
#include <dengine/de_game.h>

#include <string.h>

/* Defined by the game, with DE_GAME_EXPORT. */
const de_game_api *de_game_get_api(void);

int main(int argc, char **argv) {
    de_host_desc desc;
    memset(&desc, 0, sizeof desc);
    desc.static_api = de_game_get_api();
    desc.argc = argc;
    desc.argv = argv;
    for (int i = 1; i < argc; ++i) {
        if (argv[i] != NULL && strcmp(argv[i], "--headless") == 0)
            desc.headless = true;
    }
    return de_host_run(&desc);
}
