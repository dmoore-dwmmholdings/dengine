cmake_minimum_required(VERSION 3.26)
if(NOT DE_CLI OR NOT DE_ROOT OR NOT DE_TMP)
    message(FATAL_ERROR "shader CLI test requires DE_CLI, DE_ROOT and DE_TMP")
endif()
file(MAKE_DIRECTORY "${DE_TMP}/shader café space" "${DE_TMP}/includes")
file(COPY_FILE "${DE_ROOT}/tests/unit/gpu/data/shaders/compute.slang" "${DE_TMP}/shader café space/compute shader.slang")
file(COPY_FILE "${DE_ROOT}/tests/unit/gpu/data/shaders/tint.slang" "${DE_TMP}/includes/tint.slang")
set(source "${DE_TMP}/shader café space/compute shader.slang")

function(compile_shader name target input expected)
    set(code "${DE_TMP}/shader café space/${name}.txt")
    set(reflection "${DE_TMP}/${name}.reflection.json")
    set(report "${DE_TMP}/${name}.report.json")
    file(REMOVE "${code}" "${reflection}" "${report}")
    execute_process(COMMAND "${DE_CLI}" shader "${input}" --target "${target}" --code "${code}"
        --reflection "${reflection}" --report "${report}" -I "${DE_TMP}/includes"
        -I "${DE_ROOT}/shaders/common" -D USE_TINT=1 ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
    file(READ "${report}" json)
    string(JSON schema GET "${json}" schema)
    string(JSON status GET "${json}" status)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "bad report schema: ${json}")
    endif()
    if(expected STREQUAL "supported-or-unavailable" AND rc EQUAL 3)
        if(NOT status STREQUAL "unsupported" OR EXISTS "${code}" OR EXISTS "${reflection}")
            message(FATAL_ERROR "unsupported target wrote misleading outputs: ${json}")
        endif()
        message(STATUS "${target}: compiler reports unavailable on this host")
        return()
    endif()
    if(expected STREQUAL "supported-or-unavailable")
        set(expected 0)
    endif()
    if(NOT rc EQUAL expected)
        message(FATAL_ERROR "${name}: exit ${rc}, expected ${expected}: ${stdout} ${stderr} ${json}")
    endif()
    if(rc EQUAL 0)
        if(NOT status STREQUAL "ok")
            message(FATAL_ERROR "success report mismatch: ${json}")
        endif()
        file(READ "${code}" generated)
        file(READ "${reflection}" reflected)
        string(JSON entries LENGTH "${reflected}" entries)
        string(JSON layout TYPE "${reflected}" entries 0 layout)
        if(entries LESS 1 OR NOT layout STREQUAL "OBJECT")
            message(FATAL_ERROR "missing full reflection: ${reflected}")
        endif()
        if(target STREQUAL "spirv" AND NOT generated MATCHES "OpEntryPoint")
            message(FATAL_ERROR "SPIR-V output is not readable disassembly")
        elseif(target STREQUAL "metal" AND NOT generated MATCHES "metal_stdlib")
            message(FATAL_ERROR "Metal output is not generated MSL")
        endif()
        if(name STREQUAL "spirv")
            string(JSON tx GET "${reflected}" entries 0 threadgroup 0)
            string(JSON ty GET "${reflected}" entries 0 threadgroup 1)
            string(JSON pc GET "${reflected}" entries 0 pushConstantBytes)
            if(NOT tx EQUAL 8 OR NOT ty EQUAL 4 OR NOT pc EQUAL 16)
                message(FATAL_ERROR "wrong reflected engine ABI: ${reflected}")
            endif()
            # Repeat an existing output request: never truncate either source or results.
            file(SHA256 "${code}" before)
            file(REMOVE "${report}")
            execute_process(COMMAND "${DE_CLI}" shader "${input}" --target "${target}"
                --code "${code}" --reflection "${reflection}" --report "${report}"
                -I "${DE_TMP}/includes" RESULT_VARIABLE again TIMEOUT 60)
            file(SHA256 "${code}" after)
            if(NOT again EQUAL 2 OR NOT before STREQUAL after)
                message(FATAL_ERROR "existing output was overwritten")
            endif()
        endif()
    else()
        string(JSON count LENGTH "${json}" diagnostics)
        if(count LESS 1 OR EXISTS "${code}" OR EXISTS "${reflection}")
            message(FATAL_ERROR "compile failure lacks diagnostics or left code: ${json}")
        endif()
        string(JSON line GET "${json}" diagnostics 0 line)
        if(line LESS 1)
            message(FATAL_ERROR "source location was lost: ${json}")
        endif()
        if(name STREQUAL "broken")
            string(JSON column GET "${json}" diagnostics 0 column)
            string(JSON end_column GET "${json}" diagnostics 0 range end column)
            if(NOT line EQUAL 3 OR NOT column EQUAL 18 OR NOT end_column EQUAL 36)
                message(FATAL_ERROR "Slang's actual underline range was lost: ${json}")
            endif()
        endif()
    endif()
endfunction()

compile_shader(spirv spirv "${source}" 0 --entry cs_main)
compile_shader(metal metal "${source}" 0)
# DXC is normally absent on macOS. A host with DXC must produce real output.
compile_shader(dxil dxil "${source}" supported-or-unavailable)
compile_shader(engine spirv "${DE_ROOT}/shaders/culling/instance_cull.slang" 0)
file(WRITE "${DE_TMP}/broken shader.slang" "[shader(\"compute\")]\n[numthreads(1,1,1)]\nvoid cs_main() { missing_identifier = 1; }\n")
compile_shader(broken spirv "${DE_TMP}/broken shader.slang" 1)
file(SHA256 "${source}" source_hash)
file(REMOVE "${DE_TMP}/protect.report.json" "${DE_TMP}/protect.reflection.json")
execute_process(COMMAND "${DE_CLI}" shader "${source}" --target spirv --code "${source}"
    --reflection "${DE_TMP}/protect.reflection.json" --report "${DE_TMP}/protect.report.json"
    -I "${DE_TMP}/includes" RESULT_VARIABLE protected TIMEOUT 60)
file(SHA256 "${source}" source_after)
if(NOT protected EQUAL 2 OR NOT source_hash STREQUAL source_after)
    message(FATAL_ERROR "shader source was overwritten")
endif()
file(WRITE "${DE_TMP}/includes/tint.slang" "module tint;\npublic float4 de_tint(float4 c) { return undefined_tint; }\n")
compile_shader(import_broken spirv "${source}" 1)
file(READ "${DE_TMP}/import_broken.report.json" imported)
string(JSON imported_path GET "${imported}" diagnostics 0 source)
if(NOT imported_path STREQUAL "${DE_TMP}/includes/tint.slang")
    message(FATAL_ERROR "import error did not resolve to its include file: ${imported}")
endif()
