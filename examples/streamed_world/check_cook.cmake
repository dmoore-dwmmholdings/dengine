# DENG-836: re-cooks world "arena" into a scratch directory and requires the files to match the
# committed ones in project/assets/worlds/arena. Inputs: -DDE_COOK, -DPROJECT, -DOUT.
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${DE_COOK}" world "${PROJECT}/assets.toml" --world arena --out "${OUT}"
                RESULT_VARIABLE rc OUTPUT_VARIABLE log ERROR_VARIABLE log)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "de-cook world failed (${rc}): ${log}")
endif()
set(committed "${PROJECT}/assets/worlds/arena")
file(GLOB fresh RELATIVE "${OUT}" "${OUT}/*")
file(GLOB have RELATIVE "${committed}" "${committed}/*")
list(SORT fresh)
list(SORT have)
if(NOT fresh STREQUAL have)
 message(FATAL_ERROR "cooked files differ: fresh [${fresh}] committed [${have}]")
endif()
list(LENGTH fresh n)
if(NOT n EQUAL 7)
 message(FATAL_ERROR "expected 6 cells and cells.toml, got ${n} files")
endif()
foreach(f IN LISTS fresh)
 file(READ "${OUT}/${f}" a)
 file(READ "${committed}/${f}" b)
 if(NOT a STREQUAL b)
  message(FATAL_ERROR "${f} is stale: cook again (see project/assets.toml)")
 endif()
endforeach()
