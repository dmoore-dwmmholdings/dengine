# DeAddGame.cmake: de_add_game(), the way a game is built (SPEC §10.1, §3.2).
#
# de_add_game(NAME <name>
#             SOURCES <file>...
#             [GAME_TOML <file>])
#
#   NAME       The game's target name (lower_snake_case is usual).
#   SOURCES    The game's sources, relative to the calling CMakeLists.txt. One of them defines
#                  DE_GAME_EXPORT const de_game_api *de_game_get_api(void);
#   GAME_TOML  The project file. It is copied to the game directory as game.toml, which is
#              `game:/game.toml` when the game runs.
#
# The game directory is <current binary dir>/<name>. It holds the game binary and game.toml, and
# it is `game:/` at run time: `dengine --game` mounts the library's directory, and a Shipping
# executable's own directory is `game:/` anyway.
#
# Two forms, the same game code (DE_GAME_DYLIB tells which one this configuration builds):
#
#   Library (Debug, Dev, Release): a MODULE library `<name>` (game.dll, libgame.so,
#   libgame.dylib), compiled with hidden visibility, that exports de_game_get_api only. The
#   target `run_<name>` builds it and the host, then runs `dengine --game <library>`.
#
#   Static (Shipping): a static library `<name>_static` with the game's code and an executable
#   `<name>` whose main() (generated from src/host/exe/static_main.c.in) calls de_host_run with
#   de_host_desc.static_api = de_game_get_api(). Nothing is loaded at run time. `run_<name>`
#   runs the executable.
#
# Linking rule: the engine is linked into the host, never into a game library. The library
# leaves the engine's DE_API symbols undefined and binds them, when it is loaded, to the copy
# in the process:
#   - macOS: `-undefined dynamic_lookup`; the `dengine` executable links the whole static engine
#     and exports it. With DE_BUILD_SHARED the library links the shared `dengine` instead.
#   - Linux: a shared library may have undefined symbols; the `dengine` executable links the
#     whole static engine and exports it (-rdynamic). With DE_BUILD_SHARED, as on macOS.
#   - Windows: a DLL must link an import library for every symbol it uses, so the library
#     links the `dengine` import library, which needs DE_BUILD_SHARED=ON. Without it the
#     Windows build uses the static form for every build type (DE_GAME_DYLIB is FALSE).
# See the Trama page "Decision: A game library binds to the engine in the host process".
#
# Included from src/host/CMakeLists.txt. CMake functions are global, and tests/ and examples/
# are added after src/, so both can call de_add_game().
include_guard(GLOBAL)

if(DE_IS_SHIPPING)
    set(_de_game_dylib FALSE)
elseif(WIN32 AND NOT DE_BUILD_SHARED)
    set(_de_game_dylib FALSE)
    message(STATUS "dengine: de_add_game() builds static game executables: a Windows game DLL "
                   "needs DE_BUILD_SHARED=ON")
else()
    set(_de_game_dylib TRUE)
endif()
# Global (tests/ and examples/ read it): TRUE when de_add_game() builds game libraries.
set(DE_GAME_DYLIB ${_de_game_dylib} CACHE INTERNAL "de_add_game() builds a game library")

# The export list of a game library on ELF platforms (macOS uses -exported_symbol). Global
# paths only below: de_add_game() runs in other directories, where variables set here are unset.
set(DE__GAME_EXPORTS_MAP "${CMAKE_BINARY_DIR}/de_game_exports.map" CACHE INTERNAL "")
set(DE__STATIC_MAIN_TEMPLATE "${DE_ROOT_DIR}/src/host/exe/static_main.c.in" CACHE INTERNAL "")
if(NOT WIN32 AND NOT APPLE)
    file(CONFIGURE OUTPUT "${DE__GAME_EXPORTS_MAP}"
         CONTENT "/* Generated by cmake/DeAddGame.cmake: a game library exports only this. */\n{\n  global: de_game_get_api;\n  local: *;\n};\n")
endif()

# Makes `target` (a MODULE library) a game library: platform file name in `dir`, hidden
# visibility, only de_game_get_api exported, and the engine's symbols bound at load time.
# Internal: de_add_game() uses it, and so do the host tests for their fixture libraries.
function(de__game_library target dir)
    set_target_properties(${target} PROPERTIES
        PREFIX "${CMAKE_SHARED_LIBRARY_PREFIX}"
        SUFFIX "${CMAKE_SHARED_LIBRARY_SUFFIX}"
        LIBRARY_OUTPUT_DIRECTORY "$<1:${dir}>"
        C_VISIBILITY_PRESET hidden
        CXX_VISIBILITY_PRESET hidden
        OBJC_VISIBILITY_PRESET hidden
        VISIBILITY_INLINES_HIDDEN ON
        FOLDER "dengine/games")
    if(DE_BUILD_SHARED)
        target_link_libraries(${target} PRIVATE dengine)
    else()
        target_link_libraries(${target} PRIVATE de_config)
        if(APPLE)
            target_link_options(${target} PRIVATE "LINKER:-undefined,dynamic_lookup")
        endif()
    endif()
    if(APPLE)
        target_link_options(${target} PRIVATE "LINKER:-exported_symbol,_de_game_get_api")
    elseif(NOT WIN32)
        target_link_options(${target} PRIVATE "LINKER:--version-script=${DE__GAME_EXPORTS_MAP}")
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${DE__GAME_EXPORTS_MAP}")
    endif()
endfunction()

function(de_add_game)
    cmake_parse_arguments(PARSE_ARGV 0 G "" "NAME;GAME_TOML" "SOURCES")
    if(G_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "de_add_game: unknown arguments: ${G_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT G_NAME OR NOT G_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "de_add_game: NAME must be an identifier (got '${G_NAME}')")
    endif()
    if(NOT G_SOURCES)
        message(FATAL_ERROR "de_add_game(${G_NAME}): SOURCES is empty")
    endif()
    if(TARGET ${G_NAME})
        message(FATAL_ERROR "de_add_game: a target named '${G_NAME}' exists already")
    endif()

    set(dir "${CMAKE_CURRENT_BINARY_DIR}/${G_NAME}")
    file(MAKE_DIRECTORY "${dir}")
    if(G_GAME_TOML)
        cmake_path(ABSOLUTE_PATH G_GAME_TOML BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
                   NORMALIZE OUTPUT_VARIABLE toml)
        if(NOT EXISTS "${toml}")
            message(FATAL_ERROR "de_add_game(${G_NAME}): GAME_TOML '${toml}' does not exist")
        endif()
        # Copied again whenever the source changes (configure_file re-runs configure).
        configure_file("${toml}" "${dir}/game.toml" COPYONLY)
    endif()

    if(DE_GAME_DYLIB)
        add_library(${G_NAME} MODULE ${G_SOURCES})
        de__game_library(${G_NAME} "${dir}")
        if(TARGET dengine_exe)
            add_custom_target(run_${G_NAME}
                COMMAND dengine_exe --game "$<TARGET_FILE:${G_NAME}>"
                DEPENDS ${G_NAME} dengine_exe
                WORKING_DIRECTORY "${dir}"
                COMMENT "Running ${G_NAME} in the dengine host"
                USES_TERMINAL
                VERBATIM)
        endif()
        set(form library)
    else()
        add_library(${G_NAME}_static STATIC ${G_SOURCES})
        target_link_libraries(${G_NAME}_static PUBLIC dengine)
        set_target_properties(${G_NAME}_static PROPERTIES FOLDER "dengine/games")

        set(DE_GAME_NAME "${G_NAME}")
        set(main_c "${CMAKE_CURRENT_BINARY_DIR}/${G_NAME}_static_main.c")
        configure_file("${DE__STATIC_MAIN_TEMPLATE}" "${main_c}" @ONLY)
        add_executable(${G_NAME} "${main_c}")
        target_link_libraries(${G_NAME} PRIVATE ${G_NAME}_static dengine)
        set_target_properties(${G_NAME} PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY "$<1:${dir}>"
            FOLDER "dengine/games")
        add_custom_target(run_${G_NAME}
            COMMAND ${G_NAME}
            DEPENDS ${G_NAME}
            WORKING_DIRECTORY "${dir}"
            COMMENT "Running ${G_NAME}"
            USES_TERMINAL
            VERBATIM)
        set(form static)
    endif()
    set_target_properties(${G_NAME} PROPERTIES DE_GAME_DIR "${dir}" DE_GAME_FORM ${form})
endfunction()
