# DeTesting.cmake: test helpers (SPEC §19.1, CONVENTIONS §4/§5). These two functions are the
# stable contract every later sprint uses; change their signatures only with a DENG-2 decision.
#
# de_add_test(NAME <name>
#             SOURCES <file>...
#             [LIBS <target-or-lib>...]
#             [LABELS <label>...]
#             [TIMEOUT <seconds>])
#
#   Builds one test executable `test_<name>` from SOURCES (usually every test_*.c of one module
#   directory, written with tests/unit/de_test.h) and registers each TEST/TEST_F in it as its own
#   CTest entry, named `<suite>.<test>` when the suite equals <name> (the convention: suite `ecs`
#   in de_add_test(NAME ecs)) and `<name>.<suite>.<test>` otherwise.
#   NAME     lower_snake_case, unique in the build. By convention the module name.
#   SOURCES  test sources, relative to the calling CMakeLists.txt. de_test.c (the runner, with
#            main()) is linked automatically; do not list it.
#   LIBS     link items, typically engine modules (`de_core`) or `dengine`. Linked PRIVATE.
#   LABELS   CTest labels. Default `unit`. The module label (the name of the calling directory,
#            e.g. `ecs` for tests/unit/ecs/) is always added, so `ctest -L ecs` works.
#   TIMEOUT  per-test timeout in seconds. Default 60.
#   Every test also gets SKIP_RETURN_CODE 77, so SKIP() shows as skipped in CTest.
#   The executable links `de_build_flags` (-Wall -Wextra -Wpedantic -Werror ...). Add compile
#   definitions or extra properties on the target `test_<name>` after the call.
#
#   Discovery: after each link, the executable runs once with `--list` and the result becomes a
#   CTest include file (the gtest_discover_tests pattern), so `#ifdef`-ed tests are handled
#   exactly. Before the first build, `ctest` shows one failing `<name>_NOT_BUILT` entry. When
#   cross-compiling without CMAKE_CROSSCOMPILING_EMULATOR the executable cannot run on the build
#   host, so the whole executable is registered as a single CTest entry `<name>` instead.
#
# de_add_fuzz_target(NAME <name>
#                    SOURCES <file>...
#                    [LIBS <target-or-lib>...]
#                    [CORPUS <dir>]
#                    [TIMEOUT <seconds>])
#
#   Builds the fuzz executable `fuzz_<name>` from SOURCES, which define
#   LLVMFuzzerTestOneInput() (tests/fuzz/de_fuzz.h) and no main().
#   - libFuzzer build: when DE_FUZZ_LIBFUZZER is ON (default) and the C compiler accepts
#     -fsanitize=fuzzer (Homebrew/upstream Clang; Apple Clang does not ship libFuzzer), the
#     target is compiled and linked with -fsanitize=fuzzer,address. Not with DE_SANITIZE=thread.
#   - Otherwise it links tests/fuzz/de_fuzz_standalone.c, which replays the inputs.
#   Either way it is registered as CTest entry `fuzz.<name>` with labels `fuzz;<module>`, which
#   runs every file in CORPUS (relative to the calling CMakeLists.txt) once, without fuzzing
#   (`-runs=0`). To fuzz for real, run the libFuzzer build by hand:
#       build/<preset>/.../fuzz_<name> -max_total_time=60 <scratch-corpus-dir> <CORPUS>
#   DE_HAVE_LIBFUZZER (cached) tells which build the configuration got.
#
# Neither function does anything when DE_BUILD_TESTS is OFF, so third_party/ and src/ may call
# them unconditionally.
#
# This file is also a script (`cmake -P DeTesting.cmake`): de_add_test() runs it after each link
# to turn `--list` output into the CTest include file.

# ---- Script mode: test discovery ------------------------------------------------------------
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    # Inputs: DE_TEST_EXE, DE_TEST_OUT, DE_TEST_PREFIX, DE_TEST_LABELS (','-separated),
    #         DE_TEST_TIMEOUT, DE_TEST_EMULATOR (','-separated, may be empty).
    string(REPLACE "," ";" labels "${DE_TEST_LABELS}")
    string(REPLACE "," ";" emulator "${DE_TEST_EMULATOR}")
    execute_process(
        COMMAND ${emulator} "${DE_TEST_EXE}" --list
        OUTPUT_VARIABLE listing
        ERROR_VARIABLE errors
        RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "de_add_test: '${DE_TEST_EXE} --list' failed (${rc}):\n${errors}")
    endif()

    set(cmd_prefix "")
    foreach(part IN LISTS emulator)
        string(APPEND cmd_prefix "[==[${part}]==] ")
    endforeach()
    set(content "# Generated by cmake/DeTesting.cmake from '${DE_TEST_EXE} --list'.\n")
    string(REPLACE "\n" ";" lines "${listing}")
    set(count 0)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" test)
        if(test STREQUAL "")
            continue()
        endif()
        if(NOT test MATCHES "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$")
            message(FATAL_ERROR "de_add_test: unexpected line in '${DE_TEST_EXE} --list': ${test}")
        endif()
        # `<name>.<suite>.<test>`, shortened to `<suite>.<test>` when the suite is the test name
        # (the usual case: suite `ecs` in de_add_test(NAME ecs)). The dot counts differ, so the
        # two forms cannot collide.
        if(test MATCHES "^${DE_TEST_PREFIX}\\.")
            set(ctest_name "${test}")
        else()
            set(ctest_name "${DE_TEST_PREFIX}.${test}")
        endif()
        string(APPEND content
            "add_test([==[${ctest_name}]==] ${cmd_prefix}[==[${DE_TEST_EXE}]==] "
            "[==[--filter=${test}]==])\n"
            "set_tests_properties([==[${ctest_name}]==] PROPERTIES "
            "LABELS [==[${labels}]==] TIMEOUT ${DE_TEST_TIMEOUT} SKIP_RETURN_CODE 77)\n")
        math(EXPR count "${count} + 1")
    endforeach()
    if(count EQUAL 0)
        message(FATAL_ERROR "de_add_test: '${DE_TEST_EXE}' defines no tests")
    endif()
    # Rewrite only on change, so an unchanged listing does not touch the file's timestamp.
    set(old "")
    if(EXISTS "${DE_TEST_OUT}")
        file(READ "${DE_TEST_OUT}" old)
    endif()
    if(NOT old STREQUAL content)
        file(WRITE "${DE_TEST_OUT}" "${content}")
    endif()
    return()
endif()

# ---- Configure mode ----------------------------------------------------------------------------
include_guard(GLOBAL)

option(DE_FUZZ_LIBFUZZER "Build fuzz targets with libFuzzer when the compiler supports it" ON)
set(DE_TESTING_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

# The framework library: the runner (main) and the checks. Built only when tests are.
if(DE_BUILD_TESTS AND NOT TARGET de_test_framework)
    add_library(de_test_framework STATIC "${DE_ROOT_DIR}/tests/unit/de_test.c")
    target_include_directories(de_test_framework PUBLIC "${DE_ROOT_DIR}/tests/unit")
    target_link_libraries(de_test_framework PRIVATE de_build_flags)
    set_target_properties(de_test_framework PROPERTIES FOLDER "dengine/tests")
endif()

# Labels: LABELS (default `unit`) plus the calling directory's name.
function(de__test_labels out default)
    set(labels ${ARGN})
    if(NOT labels)
        set(labels ${default})
    endif()
    cmake_path(GET CMAKE_CURRENT_SOURCE_DIR FILENAME module)
    list(APPEND labels ${module})
    list(REMOVE_DUPLICATES labels)
    set(${out} "${labels}" PARENT_SCOPE)
endfunction()

function(de_add_test)
    if(NOT DE_BUILD_TESTS)
        return()
    endif()
    cmake_parse_arguments(PARSE_ARGV 0 T "" "NAME;TIMEOUT" "SOURCES;LIBS;LABELS")
    if(T_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "de_add_test: unknown arguments: ${T_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT T_NAME OR NOT T_NAME MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "de_add_test: NAME must be lower_snake_case (got '${T_NAME}')")
    endif()
    if(NOT T_SOURCES)
        message(FATAL_ERROR "de_add_test(${T_NAME}): SOURCES is empty")
    endif()
    if(NOT T_TIMEOUT)
        set(T_TIMEOUT 60)
    endif()
    set(target test_${T_NAME})
    if(TARGET ${target})
        message(FATAL_ERROR "de_add_test: test '${T_NAME}' is defined twice")
    endif()

    add_executable(${target} ${T_SOURCES})
    target_link_libraries(${target} PRIVATE de_test_framework de_build_flags ${T_LIBS})
    set_target_properties(${target} PROPERTIES FOLDER "dengine/tests")
    de__test_labels(labels unit ${T_LABELS})

    if(CMAKE_CROSSCOMPILING AND NOT CMAKE_CROSSCOMPILING_EMULATOR)
        add_test(NAME ${T_NAME} COMMAND ${target})
        set_tests_properties(${T_NAME} PROPERTIES
            LABELS "${labels}" TIMEOUT ${T_TIMEOUT} SKIP_RETURN_CODE 77)
        return()
    endif()

    # One generated file per configuration, so multi-config generators (Visual Studio, Xcode)
    # pick the executable of the configuration that `ctest -C` names.
    set(base "${CMAKE_CURRENT_BINARY_DIR}/${target}")
    # Relink (and so rediscover) when this script changes (Ninja and Makefile generators).
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${DE_TESTING_SCRIPT}")
    string(REPLACE ";" "," labels_arg "${labels}")
    string(REPLACE ";" "," emulator_arg "${CMAKE_CROSSCOMPILING_EMULATOR}")
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${CMAKE_COMMAND}"
            "-DDE_TEST_EXE=$<TARGET_FILE:${target}>"
            "-DDE_TEST_OUT=${base}_tests-$<CONFIG>.cmake"
            "-DDE_TEST_PREFIX=${T_NAME}"
            "-DDE_TEST_LABELS=${labels_arg}"
            "-DDE_TEST_TIMEOUT=${T_TIMEOUT}"
            "-DDE_TEST_EMULATOR=${emulator_arg}"
            -P "${DE_TESTING_SCRIPT}"
        COMMENT "Discovering tests in ${target}"
        VERBATIM)

    get_property(multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    if(multi)
        set(config_expr "\${CTEST_CONFIGURATION_TYPE}")
    elseif(CMAKE_BUILD_TYPE)
        set(config_expr "${CMAKE_BUILD_TYPE}")
    else()
        set(config_expr "")
    endif()
    string(JOIN "\n" include_content
        "set(_de_tests \"${base}_tests-${config_expr}.cmake\")"
        "if(EXISTS \"\${_de_tests}\")"
        "    include(\"\${_de_tests}\")"
        "else()"
        "    add_test([==[${T_NAME}_NOT_BUILT]==] [==[${T_NAME}_NOT_BUILT]==])"
        "    set_tests_properties([==[${T_NAME}_NOT_BUILT]==] PROPERTIES LABELS [==[${labels}]==])"
        "endif()"
        "")
    file(WRITE "${base}_include.cmake" "${include_content}")
    set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${base}_include.cmake")
endfunction()

# ---- Fuzz targets ------------------------------------------------------------------------------

# libFuzzer needs Clang with the fuzzer runtime, and it is built with ASan, which cannot share a
# process with TSan.
set(_de_libfuzzer_ok OFF)
if(DE_BUILD_TESTS AND DE_FUZZ_LIBFUZZER AND CMAKE_C_COMPILER_ID MATCHES "Clang"
   AND NOT DE_COMPILER_FRONTEND STREQUAL "MSVC" AND NOT DE_SANITIZE STREQUAL "thread")
    include(CheckCSourceCompiles)
    set(CMAKE_REQUIRED_FLAGS "-fsanitize=fuzzer")
    set(CMAKE_REQUIRED_LINK_OPTIONS "-fsanitize=fuzzer")
    set(CMAKE_REQUIRED_QUIET ON)
    check_c_source_compiles([=[
#include <stddef.h>
#include <stdint.h>
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size);
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) { (void)data; (void)size; return 0; }
]=] DE_HAVE_LIBFUZZER)
    unset(CMAKE_REQUIRED_FLAGS)
    unset(CMAKE_REQUIRED_LINK_OPTIONS)
    unset(CMAKE_REQUIRED_QUIET)
    if(DE_HAVE_LIBFUZZER)
        set(_de_libfuzzer_ok ON)
    endif()
endif()
if(DE_BUILD_TESTS)
    if(_de_libfuzzer_ok)
        message(STATUS "dengine: fuzz targets use libFuzzer")
    else()
        message(STATUS "dengine: fuzz targets use standalone corpus replay (no libFuzzer)")
    endif()
endif()
set(DE_FUZZ_USES_LIBFUZZER ${_de_libfuzzer_ok} CACHE INTERNAL "Fuzz targets link libFuzzer")

function(de_add_fuzz_target)
    if(NOT DE_BUILD_TESTS)
        return()
    endif()
    cmake_parse_arguments(PARSE_ARGV 0 F "" "NAME;CORPUS;TIMEOUT" "SOURCES;LIBS")
    if(F_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "de_add_fuzz_target: unknown arguments: ${F_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT F_NAME OR NOT F_NAME MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "de_add_fuzz_target: NAME must be lower_snake_case (got '${F_NAME}')")
    endif()
    if(NOT F_SOURCES)
        message(FATAL_ERROR "de_add_fuzz_target(${F_NAME}): SOURCES is empty")
    endif()
    if(NOT F_TIMEOUT)
        set(F_TIMEOUT 60)
    endif()
    set(target fuzz_${F_NAME})
    if(TARGET ${target})
        message(FATAL_ERROR "de_add_fuzz_target: target '${F_NAME}' is defined twice")
    endif()

    if(DE_FUZZ_USES_LIBFUZZER)
        add_executable(${target} ${F_SOURCES})
        target_compile_options(${target} PRIVATE -fsanitize=fuzzer,address)
        target_link_options(${target} PRIVATE -fsanitize=fuzzer,address)
    else()
        add_executable(${target} ${F_SOURCES} "${DE_ROOT_DIR}/tests/fuzz/de_fuzz_standalone.c")
    endif()
    target_include_directories(${target} PRIVATE "${DE_ROOT_DIR}/tests/fuzz")
    target_link_libraries(${target} PRIVATE de_build_flags ${F_LIBS})
    set_target_properties(${target} PROPERTIES FOLDER "dengine/fuzz")

    set(args -runs=0)
    if(F_CORPUS)
        cmake_path(ABSOLUTE_PATH F_CORPUS BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
                   NORMALIZE)
        if(NOT IS_DIRECTORY "${F_CORPUS}")
            message(FATAL_ERROR "de_add_fuzz_target(${F_NAME}): CORPUS '${F_CORPUS}' is not a "
                                "directory")
        endif()
        list(APPEND args "${F_CORPUS}")
    endif()
    de__test_labels(labels fuzz)
    # The working directory is the build dir, so a libFuzzer crash artifact never lands in the
    # source tree.
    add_test(NAME fuzz.${F_NAME} COMMAND ${target} ${args}
             WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
    set_tests_properties(fuzz.${F_NAME} PROPERTIES LABELS "${labels}" TIMEOUT ${F_TIMEOUT})
endfunction()
