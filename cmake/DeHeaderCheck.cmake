# DeHeaderCheck.cmake: public header compile check (SPEC §5.1, §19.3, §26).
#
# Every public header must compile on its own, as C11 and as C++17, under the strict warning set:
#
#   Clang/GCC:        -std=c11 / -std=c++17  -Wall -Wextra -Wpedantic -Wvla -Werror
#   MSVC / clang-cl:  /std:c11 / /std:c++17  /W4 /WX
#
# de_add_header_check(TARGET <name> [EXTRA_C_SOURCES <file>...])
#
#   Globs include/dengine/*.h at configure time (CONFIGURE_DEPENDS, so adding or removing a header
#   re-runs configure on the next build; no CMake edit is needed). For each header <name>.h it
#   generates into <current binary dir>/gen/:
#
#     hc_<name>.c    #include <dengine/<name>.h>, twice
#     hc_<name>.cpp  the same, compiled as C++17
#
#   and compiles all of them into the OBJECT library <TARGET>. Nothing is linked. Each generated
#   file includes exactly one header, so a header that relies on a type from a header it does not
#   include itself (for example `size_t` without <stddef.h> or de_base.h) fails. The second include
#   catches a missing or broken include guard. The umbrella dengine.h is matched by the glob, so it
#   is checked both ways too.
#
#   A de_*.h header must also wrap its declarations in DE_EXTERN_C_BEGIN / DE_EXTERN_C_END, so
#   that C++ code gets C linkage (SPEC §5.1, CONVENTIONS §3). A build step per header (this file
#   in script mode, re-run whenever the header changes) fails if either marker is missing.
#   dengine.h is exempt: it only includes the de_*.h headers.
#
#   EXTRA_C_SOURCES are compiled into the same target as C11 objects, under the same flags (used
#   for examples/minimal_game.c, which claims to compile against the headers).
#
# Why the C++ side does not trip on C-only macros: DE_STR (de_base.h) and DE_TYPE_DESC
# (de_reflect.h) expand to C99 compound literals, which are not valid C++17. The C++ check only
# includes the headers; it never expands those macros, and a macro definition is not checked
# until it is used. So they stay as they are: the guarantee is that C++ code can include every
# header and call every function, not that every convenience macro works in C++.

# ---- Script mode: cmake -DHEADER=<file> -DSTAMP=<file> -P DeHeaderCheck.cmake ----
if(CMAKE_SCRIPT_MODE_FILE)
    file(READ "${HEADER}" text)
    if(NOT text MATCHES "DE_EXTERN_C_BEGIN" OR NOT text MATCHES "DE_EXTERN_C_END")
        message(FATAL_ERROR "${HEADER}: declarations must be wrapped in "
            "DE_EXTERN_C_BEGIN / DE_EXTERN_C_END, so C++ code gets C linkage (SPEC §5.1)")
    endif()
    file(TOUCH "${STAMP}")
    return()
endif()

include_guard(GLOBAL)

function(de__header_check_write path content)
    # file(CONFIGURE) only rewrites the file when the content changes, so a re-configure does not
    # rebuild the whole check.
    file(CONFIGURE OUTPUT "${path}" CONTENT "${content}" @ONLY)
endfunction()

function(de_add_header_check)
    cmake_parse_arguments(PARSE_ARGV 0 H "" "TARGET" "EXTRA_C_SOURCES")
    if(H_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "de_add_header_check: unknown arguments: ${H_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT H_TARGET)
        message(FATAL_ERROR "de_add_header_check: TARGET is required")
    endif()

    set(include_dir "${DE_ROOT_DIR}/include")
    set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/gen")

    file(GLOB headers CONFIGURE_DEPENDS "${include_dir}/dengine/*.h")
    list(SORT headers)
    if(NOT headers)
        message(FATAL_ERROR "de_add_header_check: no headers found in ${include_dir}/dengine/")
    endif()

    set(sources "")
    set(stamps "")
    foreach(header IN LISTS headers)
        cmake_path(GET header FILENAME file)
        cmake_path(GET header STEM stem)

        set(include_line "#include <dengine/${file}>")
        string(JOIN "\n" body
            "/* Generated by cmake/DeHeaderCheck.cmake. Do not edit. */"
            "/* Standalone include: the header must bring in everything it uses. */"
            "${include_line}"
            "/* Second include: the include guard must make this a no-op. */"
            "${include_line}"
            "")

        de__header_check_write("${gen_dir}/hc_${stem}.c" "${body}")
        de__header_check_write("${gen_dir}/hc_${stem}.cpp" "${body}")
        list(APPEND sources "${gen_dir}/hc_${stem}.c" "${gen_dir}/hc_${stem}.cpp")

        # The linkage check runs at build time, not configure time, so editing a header that is
        # already globbed (no re-configure) is still checked.
        if(NOT file STREQUAL "dengine.h")
            set(stamp "${gen_dir}/hc_${stem}.externc.stamp")
            add_custom_command(OUTPUT "${stamp}"
                COMMAND "${CMAKE_COMMAND}" "-DHEADER=${header}" "-DSTAMP=${stamp}"
                        -P "${DE_ROOT_DIR}/cmake/DeHeaderCheck.cmake"
                DEPENDS "${header}" "${DE_ROOT_DIR}/cmake/DeHeaderCheck.cmake"
                COMMENT "Checking DE_EXTERN_C_BEGIN/END in dengine/${file}"
                VERBATIM)
            list(APPEND stamps "${stamp}")
        endif()
    endforeach()

    # Remove generated files of headers that no longer exist, so gen/ mirrors include/dengine/.
    file(GLOB old_sources "${gen_dir}/hc_*.c" "${gen_dir}/hc_*.cpp" "${gen_dir}/hc_*.stamp")
    foreach(old IN LISTS old_sources)
        if(NOT old IN_LIST sources AND NOT old IN_LIST stamps)
            file(REMOVE "${old}")
        endif()
    endforeach()

    # The stamps are listed as sources so their custom commands run before the target is built;
    # they are not compiled.
    add_library(${H_TARGET} OBJECT ${sources} ${stamps} ${H_EXTRA_C_SOURCES})
    target_include_directories(${H_TARGET} PRIVATE "${include_dir}")
    # de_config: the defines a consumer of the engine sees (DE_STATIC, DE_DEV, DE_HAS_<X>...).
    # de_build_flags: the strict warning set, with -Werror or /WX.
    target_link_libraries(${H_TARGET} PRIVATE de_config de_build_flags)
    # Stated on the target, not inherited from the root, so the check always tests C11 / C++17
    # with no GNU extensions (-std=c11, -std=c++17; /std:c11, /std:c++17).
    set_target_properties(${H_TARGET} PROPERTIES
        C_STANDARD 11
        C_STANDARD_REQUIRED ON
        C_EXTENSIONS OFF
        CXX_STANDARD 17
        CXX_STANDARD_REQUIRED ON
        CXX_EXTENSIONS OFF
        FOLDER "dengine/checks")

    list(LENGTH headers n)
    message(STATUS "dengine: header check covers ${n} public headers (C11 + C++17)")
endfunction()
