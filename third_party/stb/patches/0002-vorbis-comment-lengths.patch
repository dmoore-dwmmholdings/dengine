DENG-480: Validate Vorbis header sizes and arena arithmetic, safely unwind incomplete
comment lists, reject truncated size fields, and compare codebook powers without
out-of-range floating-to-integer casts.

--- a/stb_vorbis.c
+++ b/stb_vorbis.c
@@ -949,11 +949,12 @@
 
 static void *setup_malloc(vorb *f, int sz)
 {
+   if (sz < 0 || sz > INT_MAX - 7) return NULL;
    sz = (sz+7) & ~7; // round up to nearest 8 for alignment of future allocs.
    f->setup_memory_required += sz;
    if (f->alloc.alloc_buffer) {
       void *p = (char *) f->alloc.alloc_buffer + f->setup_offset;
-      if (f->setup_offset + sz > f->temp_offset) return NULL;
+      if (sz > f->temp_offset - f->setup_offset) return NULL;
       f->setup_offset += sz;
       return p;
    }
@@ -968,9 +969,10 @@
 
 static void *setup_temp_malloc(vorb *f, int sz)
 {
+   if (sz < 0 || sz > INT_MAX - 7) return NULL;
    sz = (sz+7) & ~7; // round up to nearest 8 for alignment of future allocs.
    if (f->alloc.alloc_buffer) {
-      if (f->temp_offset - sz < f->setup_offset) return NULL;
+      if (sz > f->temp_offset - f->setup_offset) return NULL;
       f->temp_offset -= sz;
       return (char *) f->alloc.alloc_buffer + f->temp_offset;
    }
@@ -1240,12 +1242,15 @@
